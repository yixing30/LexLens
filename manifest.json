{
  "manifest_version": 3,
  "name": "LexLens 本地网页阅读",
  "version": "0.7.11",
  "description": "在英文网页原位显示本地中文词义提示；网页文字不会上传。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "LexLens",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["data/english-levels.js", "data/english-inline.js", "data/english-auto.js", "src/core.js", "src/content.js"],
    "css": ["src/content.css"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "web_accessible_resources": [{
    "resources": ["data/english-lookup.json", "data/english-detail.json"],
    "matches": ["<all_urls>"]
  }]
}
